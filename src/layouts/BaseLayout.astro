---
import SeoHead from '../components/seo/SeoHead.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import CookieConsent from '../components/site/CookieConsent.astro';

import '../styles/global.css';
import '../styles/site-shell.css';
interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  canonical,
  image,
  noindex = false,
  type = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <meta name="google-site-verification" content="rr65B3ye_uM80IOh93nYzB2PcOZM1Yml-So6JBWPYdY" />

    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      noindex={noindex}
      type={type}
    />

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      window.gtag =
        window.gtag ||
        function () {
          window.dataLayer.push(arguments);
        };

      var hitdaConsent = null;

      try {
        hitdaConsent =
          localStorage.getItem('hitda-consent-v1');
      } catch (error) {
        hitdaConsent = null;
      }

      var hitdaGranted =
        hitdaConsent === 'granted';

      window.gtag('consent', 'default', {
        analytics_storage:
          hitdaGranted ? 'granted' : 'denied',
        ad_storage:
          hitdaGranted ? 'granted' : 'denied',
        ad_user_data:
          hitdaGranted ? 'granted' : 'denied',
        ad_personalization:
          hitdaGranted ? 'granted' : 'denied',
        wait_for_update: 500,
      });
    </script>
  </head>

  <body data-page-path={Astro.url.pathname}>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>

    <div class="reading-progress" aria-hidden="true">
      <span data-reading-progress-bar></span>
    </div>

    <div class="site-ambient" aria-hidden="true"></div>

    <div class="site-shell">
      <SiteHeader />

      <main id="main-content">
        <slot />
      </main>

      <SiteFooter />
    </div>

    <CookieConsent />

    <script>
      import '../scripts/commercial-tracking';

      const progressBar =
        document.querySelector(
          '[data-reading-progress-bar]',
        );

      const updateReadingProgress = (): void => {
        if (!(progressBar instanceof HTMLElement)) {
          return;
        }

        const documentHeight =
          document.documentElement.scrollHeight -
          window.innerHeight;

        const progress =
          documentHeight > 0
            ? Math.min(
                100,
                Math.max(
                  0,
                  (window.scrollY / documentHeight) * 100,
                ),
              )
            : 0;

        progressBar.style.transform =
          `scaleX(${progress / 100})`;
      };

      updateReadingProgress();

      window.addEventListener(
        'scroll',
        updateReadingProgress,
        { passive: true },
      );

      window.addEventListener(
        'resize',
        updateReadingProgress,
      );
    </script>
  </body>
</html>
