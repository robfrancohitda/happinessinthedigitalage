---
import {
  getRelatedArticles,
  type ArticleEntry,
} from '../lib/articles';

import {
  buildArticleStructuredData,
} from '../lib/article-structured-data';

import {
  splitArticleBodyHtml,
} from '../lib/article-body-segmentation';

import AdSlot from '../components/advertising/AdSlot.astro';
import ArticleBreadcrumbs from '../components/article/ArticleBreadcrumbs.astro';
import ArticleFaq from '../components/article/ArticleFaq.astro';
import ArticleHero from '../components/article/ArticleHero.astro';
import ArticleMeta from '../components/article/ArticleMeta.astro';
import ArticleReferences from '../components/article/ArticleReferences.astro';
import ArticleToc from '../components/article/ArticleToc.astro';
import DirectAnswer from '../components/article/DirectAnswer.astro';
import KeyTakeaways from '../components/article/KeyTakeaways.astro';
import RelatedArticles from '../components/article/RelatedArticles.astro';
import BaseLayout from './BaseLayout.astro';

import '../styles/article.css';
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  article: ArticleEntry;
  headings: Heading[];
  authorName?: string;
  readingTimeMinutes?: number;
  noindex?: boolean;
}

const {
  article,
  headings,
  authorName = 'Rob Franco',
  readingTimeMinutes,
  noindex = false,
} = Astro.props;

const { data } = article;

const openingContext = data.openingContext ?? [];

const relatedArticles = await getRelatedArticles(article, 3);

const articleBodyHtml =
  await Astro.slots.render('default');

const bodySegments =
  splitArticleBodyHtml(articleBodyHtml);

const enabledPlacements =
  new Set(data.commercial.placements);

const hasAffiliateRelationship =
  data.commercial.campaignIds.length > 0;

const adContext = {
  articleId: article.id,
  contentType: data.contentType,
  vertical: data.vertical,
  category: data.category,
  topic: data.topic,
  tags: data.tags,
  preferredCampaignIds:
    data.commercial.campaignIds,
  allowGlobalCampaigns:
    data.commercial.allowGlobalCampaigns,
};

const baseUrl =
  Astro.site ??
  new URL(Astro.url.origin);

const canonicalUrl =
  new URL(
    Astro.url.pathname,
    baseUrl,
  ).toString();

const structuredData =
  buildArticleStructuredData({
    article,
    authorName,
    baseUrl,
  });
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  canonical={canonicalUrl}
  image={data.hero?.desktop.src}
  imageAlt={data.hero?.alt}
  socialTitle={data.socialTitle}
  socialDescription={data.socialDescription}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  structuredData={structuredData}
  noindex={noindex}
>
  <article class="article-page">
    {
      enabledPlacements.has('article-masthead') && (
        <div class="article-ad article-ad--masthead">
          <AdSlot
            {...adContext}
            placement="article-masthead"
          />
        </div>
      )
    }

    <header class="article-header">
      <ArticleBreadcrumbs
        contentType={data.contentType}
        title={data.title}
      />

      <ArticleMeta
        contentType={data.contentType}
        category={data.category}
        authorName={authorName}
        publishedAt={data.publishedAt}
        updatedAt={data.updatedAt}
        readingTimeMinutes={readingTimeMinutes}
      />

      {
        hasAffiliateRelationship && (
          <p class="article-affiliate-note">
            This page contains affiliate links. HITDA may earn a commission.
          </p>
        )
      }

      <div class="article-header__title">
        <h1>{data.title}</h1>
        <p>{data.description}</p>
      </div>
    </header>

    {
      data.hero && (
        <div class="article-hero-container">
          <ArticleHero hero={data.hero} />
        </div>
      )
    }

    <div class="article-reading-column">
      {
        openingContext.length > 0 && (
          <section
            class="article-opening"
            aria-label="Introduction"
          >
            {
              openingContext.map((paragraph) => (
                <p>{paragraph}</p>
              ))
            }
          </section>
        )
      }

      <DirectAnswer answer={data.answerSummary} />

      <KeyTakeaways items={data.keyTakeaways} />

      <ArticleToc headings={headings} />

      <div class="article-body">
        <Fragment
          set:html={bodySegments.beforeInline}
        />

        {
          bodySegments.insertInline &&
          enabledPlacements.has('article-inline-text') && (
            <AdSlot
              {...adContext}
              placement="article-inline-text"
            />
          )
        }

        <Fragment
          set:html={bodySegments.betweenAds}
        />

        {
          bodySegments.insertVisual &&
          enabledPlacements.has('article-visual-card') && (
            <AdSlot
              {...adContext}
              placement="article-visual-card"
            />
          )
        }

        <Fragment
          set:html={bodySegments.afterVisual}
        />
      </div>

      <ArticleFaq items={data.faq} />

      <ArticleReferences sources={data.sources} />
    </div>

    {
      enabledPlacements.has('article-final-banner') && (
        <div class="article-ad article-ad--final-banner">
          <AdSlot
            {...adContext}
            placement="article-final-banner"
          />
        </div>
      )
    }

    <RelatedArticles articles={relatedArticles} />
  </article>
</BaseLayout>

<style>
  .article-affiliate-note {
    margin: 0.75rem 0 0;
    color: var(--text-soft);
    font-size: 0.72rem;
    line-height: 1.45;
  }
</style>
