---
import BaseLayout from '../layouts/BaseLayout.astro';

import '../styles/home.css';
import '../styles/premium-home.css';
---

<BaseLayout
  title="HITDA — Happiness in the Digital Age"
  description="Independent guides, explainers, reviews and comparisons for work, money, technology, wellbeing and everyday life."
  canonical="https://www.happinessinthedigitalage.digital/"
>
  <section class="hitda-hero" aria-labelledby="home-title">
    <div class="hitda-hero__copy">
      <p class="hitda-eyebrow">
        Independent digital-life publication
      </p>

      <h1 id="home-title">
        Clearer choices for life in the
        <em>digital age.</em>
      </h1>

      <p class="hitda-lead">
        Independent guides, explainers, reviews and
        comparisons for work, money, technology,
        wellbeing and everyday life.
      </p>

      <div class="hitda-actions">
        <a class="hitda-button hitda-button--coral" href="#latest">
          Explore the latest
        </a>

        <a class="hitda-button hitda-button--outline" href="/reviews/">
          Browse reviews
        </a>
      </div>

      <div class="hero-principles">
        <div>
          <strong>Independent</strong>
          <span>
            Commercial relationships do not determine conclusions.
          </span>
        </div>

        <div>
          <strong>Practical</strong>
          <span>
            Useful answers before unnecessary complexity.
          </span>
        </div>

        <div>
          <strong>Human</strong>
          <span>
            Digital life explained through real decisions.
          </span>
        </div>
      </div>
    </div>

    <div class="hitda-hero__visual" aria-label="HITDA editorial universe">
      <div class="visual-grid">
        <article class="visual-block visual-block--main">
          <small>Happiness in the Digital Age</small>

          <strong>
            Life<br />
            Work<br />
            Tech
          </strong>
        </article>

        <article class="visual-block visual-block--acid">
          <small>Field 01</small>
          <strong>Money</strong>
        </article>

        <article class="visual-block visual-block--paper">
          <small>Field 02</small>
          <strong>Wellbeing</strong>
        </article>

        <article class="visual-block visual-block--wide">
          <div>
            <small>Editorial system</small>

            <strong>
              Useful information.<br />
              Better decisions.
            </strong>
          </div>

          <span class="visual-index">26</span>
        </article>
      </div>
    </div>
  </section>

  <section class="editorial-manifesto" aria-label="Editorial principles">
    <article>
      <span>01</span>
      <strong>Answer the real question</strong>
      <p>
        Start with the decision the reader actually needs to make.
      </p>
    </article>

    <article>
      <span>02</span>
      <strong>Separate evidence from claims</strong>
      <p>
        Show what is known, what is promoted and what remains uncertain.
      </p>
    </article>

    <article>
      <span>03</span>
      <strong>Respect the reader's time</strong>
      <p>
        Direct language, useful structure and no decorative complexity.
      </p>
    </article>

    <article>
      <span>04</span>
      <strong>Keep commerce visible</strong>
      <p>
        Affiliate relationships are disclosed without taking over the work.
      </p>
    </article>
  </section>

  <section class="featured-review" aria-labelledby="featured-title">
    <div class="featured-review__copy">
      <p class="hitda-eyebrow">
        Featured review
      </p>

      <h2 id="featured-title">
        Before you buy, know what to check.
      </h2>

      <p class="hitda-lead">
        Our NeuroVera review examines the seller's claims,
        available ingredient information, price structure and
        the points that deserve closer attention.
      </p>

      <dl class="featured-details">
        <div>
          <dt>Format</dt>
          <dd>Independent product review</dd>
        </div>

        <div>
          <dt>Author</dt>
          <dd>Emily Carter</dd>
        </div>

        <div>
          <dt>Focus</dt>
          <dd>
            Ingredients, price, evidence and buying considerations
          </dd>
        </div>
      </dl>

      <a
        class="hitda-button hitda-button--coral"
        href="/reviews/neurovera-review/"
      >
        Read the NeuroVera review
      </a>
    </div>

    <div class="featured-review__visual" aria-hidden="true">
      <div class="review-composition">
        <div class="review-name">
          <strong>NeuroVera</strong>
        </div>

        <div class="review-file">
          <span>Review file</span>
          <strong>01</strong>
        </div>

        <div class="review-caption">
          <strong>Ingredients · price · claims</strong>
          <span>Updated Aug 2, 2026</span>
        </div>
      </div>
    </div>
  </section>

  <section class="coverage-section" aria-labelledby="coverage-title">
    <div class="hitda-container">
      <header class="hitda-section-heading">
        <h2 id="coverage-title">
          What HITDA covers
        </h2>

        <p class="hitda-lead">
          Broad subjects organized around practical choices
          rather than abstract trends.
        </p>
      </header>

      <div class="coverage-grid">
        <a href="/guides/" class="coverage-card">
          <span>01</span>
          <h3>Work</h3>
          <p>
            Tools, systems and decisions for working in a digital economy.
          </p>
        </a>

        <a href="/explainers/" class="coverage-card">
          <span>02</span>
          <h3>Technology</h3>
          <p>
            Products, platforms and changes that affect everyday life.
          </p>
        </a>

        <a href="/resources/" class="coverage-card">
          <span>03</span>
          <h3>Money</h3>
          <p>
            Costs, value, digital finance and consumer decisions.
          </p>
        </a>

        <a href="/reviews/" class="coverage-card">
          <span>04</span>
          <h3>Wellbeing</h3>
          <p>
            Products and habits connected to health, attention and rest.
          </p>
        </a>

        <a href="/comparisons/" class="coverage-card">
          <span>05</span>
          <h3>Home</h3>
          <p>
            Choices that make everyday environments more functional.
          </p>
        </a>

        <a href="/guides/" class="coverage-card">
          <span>06</span>
          <h3>Relationships</h3>
          <p>
            Communication and human connection in digital routines.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section class="formats-section" aria-labelledby="formats-title">
    <div class="hitda-container">
      <header class="hitda-section-heading">
        <h2 id="formats-title">
          Five ways to explore
        </h2>

        <p class="hitda-lead">
          Each format has one job: explain, compare,
          evaluate, guide or organize.
        </p>
      </header>

      <div class="format-list">
        <a href="/guides/" class="format-row">
          <span class="format-number">01</span>
          <h3>Guides</h3>
          <p>
            Step-by-step help for completing a task or solving a problem.
          </p>
          <span class="format-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/explainers/" class="format-row">
          <span class="format-number">02</span>
          <h3>Explainers</h3>
          <p>
            What something is, how it works and why it matters.
          </p>
          <span class="format-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/reviews/" class="format-row">
          <span class="format-number">03</span>
          <h3>Reviews</h3>
          <p>
            Evaluation of products, offers, claims and limitations.
          </p>
          <span class="format-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/comparisons/" class="format-row">
          <span class="format-number">04</span>
          <h3>Comparisons</h3>
          <p>
            Side-by-side analysis focused on meaningful differences.
          </p>
          <span class="format-arrow" aria-hidden="true">→</span>
        </a>

        <a href="/resources/" class="format-row">
          <span class="format-number">05</span>
          <h3>Resources</h3>
          <p>
            Selected tools, references and practical material.
          </p>
          <span class="format-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="authors-section" aria-labelledby="authors-title">
    <div class="hitda-container">
      <header class="hitda-section-heading">
        <h2 id="authors-title">
          Editorial voices
        </h2>

        <p class="hitda-lead">
          Three areas of responsibility.
          One publication standard.
        </p>
      </header>

      <div class="authors-grid">
        <article class="author-card">
          <span class="author-initials">RF</span>

          <h3>Rob Franco</h3>

          <p>
            Reviews, comparisons, products,
            affiliate coverage and editorial direction.
          </p>
        </article>

        <article class="author-card author-card--green">
          <span class="author-initials">CB</span>

          <h3>Claire Bennett</h3>

          <p>
            Work, money, technology,
            digital life and practical guides.
          </p>
        </article>

        <article class="author-card">
          <span class="author-initials">EC</span>

          <h3>Emily Carter</h3>

          <p>
            Wellbeing, health, relationships,
            home and lifestyle.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section
    class="latest-section"
    id="latest"
    aria-labelledby="latest-title"
  >
    <div class="hitda-container">
      <header class="hitda-section-heading">
        <h2 id="latest-title">
          Start here
        </h2>

        <p class="hitda-lead">
          The first review establishes the practical
          editorial standard for what comes next.
        </p>
      </header>

      <div class="latest-grid">
        <a
          href="/reviews/neurovera-review/"
          class="latest-card latest-card--main"
        >
          <small>Review · Emily Carter</small>

          <h3>
            NeuroVera Review: Ingredients, Price,
            and What to Check Before Buying
          </h3>

          <p>
            A cautious look at the available information,
            seller claims and the questions a buyer should ask.
          </p>

          <span>Read the review →</span>
        </a>

        <a
          href="/reviews/"
          class="latest-card latest-card--green"
        >
          <small>Editorial index</small>

          <h3>
            Browse all reviews
          </h3>

          <p>
            Explore current and future product evaluations
            in one dedicated section.
          </p>

          <span>Open reviews →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="closing-section" aria-labelledby="closing-title">
    <div class="closing-section__copy">
      <h2 id="closing-title">
        Better information should make
        the next step clearer.
      </h2>

      <p class="hitda-lead">
        Begin with practical reviews today,
        then follow HITDA as every section expands.
      </p>

      <a class="hitda-button hitda-button--light" href="/reviews/">
        Explore HITDA reviews
      </a>
    </div>

    <div class="closing-section__panel" aria-hidden="true">
      <span>Happiness in the Digital Age</span>
      <strong>Think clearer.</strong>
    </div>
  </section>
</BaseLayout>
