---
import BaseLayout from '../layouts/BaseLayout.astro';

import '../styles/home.css';
---

<BaseLayout
  title="HITDA — Your Hub for Smarter Everyday Decisions"
  description="Explore practical guides, clear explainers, useful reviews and direct comparisons across technology, money, work, wellbeing, home and relationships."
  canonical="https://www.happinessinthedigitalage.digital/"
>
  <section class="hitda-hero" aria-labelledby="home-title">
    <div class="hitda-hero__copy">
      <p class="hitda-eyebrow">
        Your information hub for modern life
      </p>

      <h1 id="home-title">
        Make sense of
        <em>modern life.</em>
      </h1>

      <p class="hitda-lead">
        HITDA brings practical guides, clear explainers,
        useful reviews and direct comparisons together in
        one place—so you can understand faster, compare
        better and make more confident everyday decisions.
      </p>

      <div class="hitda-actions">
        <a
          class="hitda-button hitda-button--coral"
          href="#topics"
        >
          Explore the hub
        </a>

        <a
          class="hitda-button hitda-button--outline"
          href="/reviews/neurovera-review/"
        >
          See what's new
        </a>
      </div>

      <div class="hero-principles">
        <div>
          <strong>Understand faster</strong>

          <span>
            Find clear answers without spending hours
            searching through disconnected information.
          </span>
        </div>

        <div>
          <strong>Compare better</strong>

          <span>
            See the differences, trade-offs and details
            that actually matter.
          </span>
        </div>

        <div>
          <strong>Choose confidently</strong>

          <span>
            Turn information into a useful next step
            for your real life.
          </span>
        </div>
      </div>
    </div>

    <div
      class="hitda-hero__visual"
      aria-label="HITDA information hub"
    >
      <div class="visual-grid">
        <article class="visual-block visual-block--main">
          <small>Your information hub</small>

          <strong>
            Learn<br />
            Compare<br />
            Choose
          </strong>
        </article>

        <article class="visual-block visual-block--acid">
          <small>Explore</small>
          <strong>Six areas</strong>
        </article>

        <article class="visual-block visual-block--paper">
          <small>Discover</small>
          <strong>One place</strong>
        </article>

        <article class="visual-block visual-block--wide">
          <div>
            <small>Happiness in the Digital Age</small>

            <strong>
              Useful answers for the way life works now.
            </strong>
          </div>

          <span class="visual-index">HUB</span>
        </article>
      </div>
    </div>
  </section>

  <section
    class="editorial-manifesto"
    aria-label="Benefits of using HITDA"
  >
    <article>
      <span>01</span>

      <strong>Everything in one place</strong>

      <p>
        Explore connected subjects without jumping
        between scattered and unrelated sources.
      </p>
    </article>

    <article>
      <span>02</span>

      <strong>Answers you can use</strong>

      <p>
        Go beyond general information and find practical
        guidance for real questions and decisions.
      </p>
    </article>

    <article>
      <span>03</span>

      <strong>Clarity before you buy</strong>

      <p>
        Understand claims, prices, differences and
        limitations before spending your money.
      </p>
    </article>

    <article>
      <span>04</span>

      <strong>Made for everyday life</strong>

      <p>
        Find information connected to the way you
        work, live, spend, rest and relate.
      </p>
    </article>
  </section>

  <section
    class="coverage-section"
    id="topics"
    aria-labelledby="coverage-title"
  >
    <div class="hitda-container">
      <header class="hitda-section-heading">
        <h2 id="coverage-title">
          Explore what matters most.
        </h2>

        <p class="hitda-lead">
          Start with a topic or follow the question in
          front of you. HITDA connects the different parts
          of modern life, making useful information easier
          to find and easier to apply.
        </p>
      </header>

      <div class="coverage-grid">
        <a href="/guides/" class="coverage-card">
          <span>01</span>

          <h3>Work</h3>

          <p>
            Improve the way you organize, create,
            communicate and grow in a digital economy.
          </p>
        </a>

        <a href="/explainers/" class="coverage-card">
          <span>02</span>

          <h3>Technology</h3>

          <p>
            Understand the tools, platforms and changes
            shaping your everyday digital experience.
          </p>
        </a>

        <a href="/resources/" class="coverage-card">
          <span>03</span>

          <h3>Money</h3>

          <p>
            Compare value, understand costs and make
            smarter decisions about where your money goes.
          </p>
        </a>

        <a href="/reviews/" class="coverage-card">
          <span>04</span>

          <h3>Wellbeing</h3>

          <p>
            Explore products, habits and ideas connected
            to health, attention, energy and rest.
          </p>
        </a>

        <a href="/comparisons/" class="coverage-card">
          <span>05</span>

          <h3>Home</h3>

          <p>
            Find practical ways to make everyday spaces
            more comfortable, functional and organized.
          </p>
        </a>

        <a href="/guides/" class="coverage-card">
          <span>06</span>

          <h3>Relationships</h3>

          <p>
            Navigate communication, boundaries and human
            connection in technology-shaped routines.
          </p>
        </a>
      </div>
    </div>
  </section>

  <section
    class="featured-review"
    aria-labelledby="featured-title"
  >
    <div class="featured-review__copy">
      <p class="hitda-eyebrow">
        Featured now
      </p>

      <h2 id="featured-title">
        Considering NeuroVera?
        Get the full picture first.
      </h2>

      <p class="hitda-lead">
        Our review brings the key information together:
        what the product promises, which ingredient details
        are available, how the offer is priced and what you
        should consider before buying.
      </p>

      <dl class="featured-details">
        <div>
          <dt>Topic</dt>
          <dd>Wellbeing</dd>
        </div>

        <div>
          <dt>Type</dt>
          <dd>Product review</dd>
        </div>

        <div>
          <dt>Inside</dt>

          <dd>
            Claims, ingredients, pricing and
            buying considerations
          </dd>
        </div>
      </dl>

      <a
        class="hitda-button hitda-button--coral"
        href="/reviews/neurovera-review/"
      >
        Read the full review
      </a>
    </div>

    <div class="featured-review__visual" aria-hidden="true">
      <div class="review-composition">
        <div class="review-name">
          <strong>NeuroVera</strong>
        </div>

        <div class="review-file">
          <span>Featured review</span>
          <strong>01</strong>
        </div>

        <div class="review-caption">
          <strong>Product · claims · price</strong>
          <span>Full review available</span>
        </div>
      </div>
    </div>
  </section>

  <section
    class="formats-section"
    aria-labelledby="formats-title"
  >
    <div class="hitda-container">
      <header class="hitda-section-heading">
        <h2 id="formats-title">
          Find the right kind of answer.
        </h2>

        <p class="hitda-lead">
          Some questions need a quick explanation.
          Others need a step-by-step guide, a detailed
          review or a direct comparison. Choose the
          format that helps you move forward.
        </p>
      </header>

      <div class="format-list">
        <a href="/guides/" class="format-row">
          <span class="format-number">01</span>

          <h3>Guides</h3>

          <p>
            Learn what to do next with practical,
            step-by-step direction.
          </p>

          <span class="format-arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a href="/explainers/" class="format-row">
          <span class="format-number">02</span>

          <h3>Explainers</h3>

          <p>
            Understand unfamiliar subjects without
            unnecessary jargon or complexity.
          </p>

          <span class="format-arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a href="/reviews/" class="format-row">
          <span class="format-number">03</span>

          <h3>Reviews</h3>

          <p>
            Look beyond the marketing and understand
            what deserves your attention before buying.
          </p>

          <span class="format-arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a href="/comparisons/" class="format-row">
          <span class="format-number">04</span>

          <h3>Comparisons</h3>

          <p>
            See meaningful differences side by side
            and identify which option fits you better.
          </p>

          <span class="format-arrow" aria-hidden="true">
            →
          </span>
        </a>

        <a href="/resources/" class="format-row">
          <span class="format-number">05</span>

          <h3>Resources</h3>

          <p>
            Discover useful tools, references and
            information worth keeping close.
          </p>

          <span class="format-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </div>
  </section>

  <section
    class="closing-section"
    aria-labelledby="closing-title"
  >
    <div class="closing-section__copy">
      <h2 id="closing-title">
        Start here.
        Leave with a clearer next step.
      </h2>

      <p class="hitda-lead">
        Use HITDA whenever you need to understand
        something new, compare your options or make
        a more informed everyday choice.
      </p>

      <a
        class="hitda-button hitda-button--light"
        href="#topics"
      >
        Browse HITDA
      </a>
    </div>

    <div class="closing-section__media">
      <picture>
        <source
          media="(max-width: 680px)"
          srcset="/assets/site/home/hitda-home-closing-mobile.webp"
        />

        <img
          src="/assets/site/home/hitda-home-closing-desktop.webp"
          alt=""
          width="1600"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </div>
  </section>
</BaseLayout>
