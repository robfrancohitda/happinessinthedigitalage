---
import StructuredData from './StructuredData.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  socialTitle?: string;
  socialDescription?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  socialTitle,
  socialDescription,
  noindex = false,
  type = 'website',
  publishedAt,
  updatedAt,
  structuredData,
} = Astro.props;

const siteName = 'Happiness in the Digital Age';
const baseUrl = Astro.site ?? Astro.url.origin;

const pageTitle =
  title === siteName ? title : `${title} | ${siteName}`;

const socialPageTitle =
  socialTitle ??
  pageTitle;

const socialPageDescription =
  socialDescription ??
  description;

const canonicalUrl = canonical
  ? new URL(canonical, baseUrl)
  : new URL(Astro.url.pathname, baseUrl);

const imageUrl = image ? new URL(image, baseUrl) : undefined;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type} />
<meta property="og:title" content={socialPageTitle} />
<meta property="og:description" content={socialPageDescription} />
<meta property="og:url" content={canonicalUrl} />

{
  imageUrl && (
    <meta property="og:image" content={imageUrl} />
  )
}

{
  imageUrl && imageAlt && (
    <meta property="og:image:alt" content={imageAlt} />
  )
}

{
  type === 'article' && publishedAt && (
    <meta
      property="article:published_time"
      content={publishedAt.toISOString()}
    />
  )
}

{
  type === 'article' && (
    <meta
      property="article:modified_time"
      content={(updatedAt ?? publishedAt)?.toISOString()}
    />
  )
}

<meta
  name="twitter:card"
  content={imageUrl ? 'summary_large_image' : 'summary'}
/>
<meta name="twitter:title" content={socialPageTitle} />
<meta
  name="twitter:description"
  content={socialPageDescription}
/>

{
  imageUrl && (
    <meta name="twitter:image" content={imageUrl} />
  )
}

{
  imageUrl && imageAlt && (
    <meta name="twitter:image:alt" content={imageAlt} />
  )
}

{
  noindex && (
    <meta name="robots" content="noindex, nofollow" />
  )
}

{
  structuredData && (
    <StructuredData data={structuredData} />
  )
}
