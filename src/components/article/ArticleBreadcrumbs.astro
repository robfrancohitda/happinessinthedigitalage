---
import {
  articleTypeLabel,
  type ArticleContentType,
} from '../../lib/articles';

interface Props {
  contentType: ArticleContentType;
  title: string;
}

const {
  contentType,
  title,
} = Astro.props;
---

<nav class="article-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li>
      <a href="/">Home</a>
    </li>

    <li aria-hidden="true">/</li>

    <li>
      <span>{articleTypeLabel[contentType]}</span>
    </li>

    <li aria-hidden="true">/</li>

    <li aria-current="page">
      <span>{title}</span>
    </li>
  </ol>
</nav>
