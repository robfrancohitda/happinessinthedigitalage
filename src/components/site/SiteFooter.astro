---
const year = new Date().getFullYear();

const navigation = [
  { href: '/#topics', label: 'Topics' },
  { href: '/#latest', label: 'Latest' },
  { href: '/#what-to-expect', label: 'What to expect' },
];

const information = [
  { href: '/contact/', label: 'Contact' },
  { href: '/privacy/', label: 'Privacy & cookies' },
  { href: '/terms/', label: 'Terms of use' },
  {
    href: '/affiliate-disclosure/',
    label: 'Affiliate disclosure',
  },
];
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__identity">
      <a class="site-footer__brand" href="/">
        Happiness in the Digital Age
      </a>

      <p>
        Practical guidance for living, working and choosing better in
        a changing world.
      </p>
    </div>

    <nav
      class="site-footer__navigation"
      aria-label="Footer navigation"
    >
      <p class="site-footer__heading">Navigate</p>

      {
        navigation.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>

    <nav
      class="site-footer__information"
      aria-label="Site information"
    >
      <p class="site-footer__heading">Information</p>

      {
        information.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
  </div>

  <div class="site-footer__legal">
    <p>© {year} HITDA. All rights reserved.</p>

    <p>
      Some pages contain affiliate links. Editorial conclusions remain
      independent.
    </p>
  </div>
</footer>
