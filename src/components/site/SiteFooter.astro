---
const year = new Date().getFullYear();

const links = [
  { href: '/contact/', label: 'Contact' },
  { href: '/privacy/', label: 'Privacy & cookies' },
  { href: '/terms/', label: 'Terms of use' },
  {
    href: '/affiliate-disclosure/',
    label: 'Affiliate disclosure',
  },
];
---

<footer class="site-footer">
  <div class="hitda-container footer-grid">
    <div>
      <a class="footer-brand" href="/">
        HITDA
      </a>

      <p class="footer-title">
        Happiness in the Digital Age
      </p>

      <p class="footer-copy">
        A practical information hub for technology, money,
        work, wellbeing, home and relationships.
      </p>
    </div>

    <nav class="footer-links" aria-label="Information">
      {
        links.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>
  </div>

  <div class="hitda-container footer-bottom">
    <p>© {year} HITDA. All rights reserved.</p>

    <p>
      Affiliate links may generate a commission.
      Editorial conclusions remain independent.
    </p>
  </div>
</footer>
