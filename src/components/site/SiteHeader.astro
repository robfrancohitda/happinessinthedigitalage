---
const currentPath = Astro.url.pathname;

const navigation = [
  { href: '/guides/', label: 'Guides' },
  { href: '/explainers/', label: 'Explainers' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/comparisons/', label: 'Comparisons' },
  { href: '/resources/', label: 'Resources' },
];

function isCurrentSection(href: string): boolean {
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="site-header__inner">
    <a
      class="site-brand"
      href="/"
      aria-label="Happiness in the Digital Age home"
      aria-current={currentPath === '/' ? 'page' : undefined}
    >
      <span class="site-brand__mark" aria-hidden="true">
        H
      </span>

      <span class="site-brand__copy">
        <span class="site-brand__primary">
          Happiness
        </span>

        <span class="site-brand__secondary">
          in the Digital Age
        </span>
      </span>
    </a>

    <nav
      class="site-navigation site-navigation--desktop"
      aria-label="Primary navigation"
    >
      {
        navigation.map((item) => (
          <a
            href={item.href}
            aria-current={
              isCurrentSection(item.href)
                ? 'page'
                : undefined
            }
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <details class="mobile-navigation">
      <summary aria-label="Open navigation">
        <span>Menu</span>

        <span
          class="mobile-navigation__icon"
          aria-hidden="true"
        ></span>
      </summary>

      <nav aria-label="Mobile navigation">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              aria-current={
                isCurrentSection(item.href)
                  ? 'page'
                  : undefined
              }
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
