---
interface Props {
  text?: string;
  compact?: boolean;
}

const {
  text = 'We may earn a commission from purchases made through links on this page.',
  compact = false,
} = Astro.props;
---

<p
  class:list={[
    'affiliate-disclosure',
    { 'affiliate-disclosure--compact': compact },
  ]}
>
  {text}
</p>

<style>
  .affiliate-disclosure {
    margin-block: 0.5rem 1rem;
    color: var(--color-muted, #5f6875);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .affiliate-disclosure--compact {
    margin-block: 0.35rem;
    font-size: 0.7rem;
  }
</style>
