---
import { render } from 'astro:content';

import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getAuthorName } from '../../data/authors';

import type {
  ArticleEntry,
} from '../../lib/articles';

interface Props {
  article: ArticleEntry;
}

const { article } = Astro.props;

const {
  Content,
  headings,
} = await render(article);

const authorName = getAuthorName(article.data.authorId);
---

<ArticleLayout
  article={article}
  headings={headings}
  authorName={authorName}
>
  <Content />
</ArticleLayout>
